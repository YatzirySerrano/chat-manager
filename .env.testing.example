# Copy to .env.testing and fill in the credentials of a MariaDB user that can
# only access the testing database. Pest and the browser scenarios
# (php tests/e2e/run.php) only rebuild chatmanager_testing, take turns on it
# through a lock and never create other databases.
APP_NAME=ChatManager
APP_ENV=testing
APP_KEY=
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatmanager_testing
DB_USERNAME=chatmanager_test
DB_PASSWORD=

# Exports: the test that really prints a PDF is skipped unless these exist.
# EXPORTS_NODE_BINARY=/usr/local/bin/node
# EXPORTS_NPM_BINARY=/usr/local/bin/npm
# EXPORTS_CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
