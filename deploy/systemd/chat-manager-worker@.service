# Chat Manager — queue worker as a systemd template (alternative to Supervisor).
# One instance per worker group, e.g.:
#   sudo cp deploy/systemd/*.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now chat-manager-worker@critical-1 chat-manager-worker@critical-2 \
#       chat-manager-worker@media-1 chat-manager-worker@general-1 chat-manager-worker@exports-1
# The group is the part of the instance name before "-" (critical, media, general, exports).
[Unit]
Description=Chat Manager queue worker (%i)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/chat-manager/current
# "$$" and "%%" are systemd escapes for "$" and "%" inside the shell snippet.
ExecStart=/bin/sh -c 'group="$${0%%-*}"; case "$$group" in \
  critical) exec php artisan queue:work database --queue=webhooks,messages --sleep=1 --tries=3 --backoff=10 --timeout=150 --max-time=3600 --memory=256 ;; \
  media) exec php artisan queue:work database --queue=media --sleep=2 --tries=3 --backoff=30 --timeout=180 --max-time=3600 --memory=512 ;; \
  general) exec php artisan queue:work database --queue=notifications,default --sleep=1 --tries=3 --backoff=5 --timeout=120 --max-time=3600 --memory=256 ;; \
  exports) exec php artisan queue:work database --queue=exports --sleep=3 --tries=1 --timeout=660 --max-time=7200 --memory=1024 ;; \
  *) echo "unknown worker group $$group" >&2; exit 1 ;; esac' %i
Restart=always
RestartSec=3
# Above the longest --timeout of the group (exports: 660 s).
TimeoutStopSec=700
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
