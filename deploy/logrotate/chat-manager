# Chat Manager — logrotate (sudo cp to /etc/logrotate.d/chat-manager).
# Laravel's own files: with LOG_STACK=single the application writes
# storage/logs/laravel.log (rotated here). With LOG_STACK=daily Laravel
# rotates by itself (LOG_DAILY_DAYS) and only the supervisor logs need this.
# copytruncate: PHP-FPM and long-running workers keep the file open.

/var/www/chat-manager/shared/storage/logs/laravel.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su www-data www-data
}

# Supervisor (root), the backups (root) and PHP-FPM errors (www-data, file
# created with install -o www-data). /var/log/chatmanager must stay
# root:root 0755: logrotate refuses directories writable by other users.
# copytruncate keeps each file's owner and mode, so www-data can still write
# php-fpm-errors.log after the rotation.
/var/log/chatmanager/*.log {
    su root root
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
