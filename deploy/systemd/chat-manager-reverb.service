# Chat Manager — Laravel Reverb (alternative to the Supervisor program).
[Unit]
Description=Chat Manager Reverb WebSocket server
# Redis only matters with REVERB_SCALING_ENABLED=true; ordering on a missing unit is ignored.
After=network.target redis-server.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/chat-manager/current
ExecStart=/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=3
LimitNOFILE=10000
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
