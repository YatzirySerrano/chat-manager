# Local development defaults. For production follow docs/puesta-en-produccion.md
# (ordered checklist and the minimum production values of this file).
# APP_NAME is the default platform name and the mail sender name.
APP_NAME="Chat Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://<domain>
# (Meta only delivers webhooks to https). Verify with: php artisan app:preflight
# (read-only; see docs/infraestructura-y-despliegue.md).
# APP_KEY encrypts the Meta credentials of every connection: back it up apart
# from the server. To rotate it, keep the old one in APP_PREVIOUS_KEYS.
#APP_PREVIOUS_KEYS=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_STACK=daily and LOG_LEVEL=warning ("debug" fills the disk; the
# preflight warns about it). Days of daily files kept:
#LOG_DAILY_DAYS=14

# The single application database (in production, the only one). Give its user
# privileges on this database only, so a typo can never create another one.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatmanager
DB_USERNAME=chatmanager_app
DB_PASSWORD=
# Fuerza InnoDB: WAMP trae MyISAM por defecto (índice máx. 1000 bytes, rompe utf8mb4)
DB_ENGINE=InnoDB
# Destructive commands (migrate:fresh, migrate:rollback, db:wipe...) are blocked
# except on the testing database (chatmanager_testing) or when this flag is
# enabled on a local machine. Never in production.
DB_ALLOW_DESTRUCTIVE_COMMANDS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure (HTTPS-only) session cookies default to true when APP_URL is https.
#SESSION_SECURE_COOKIE=true
# Keep "lax": "none" would mix the agents' session with the embedded web chat.
#SESSION_SAME_SITE=lax
# Inertia encrypts the page data kept in the browser history (needs HTTPS or
# localhost) and clears it on sign out.
INERTIA_ENCRYPT_HISTORY=true
# Local only: the Inertia DevTools recorder adds 20-70 ms to every request.
#INERTIA_DEVTOOLS_ENABLED=false

# Reverse proxy addresses trusted for X-Forwarded-* (Nginx on the same host:
# 127.0.0.1). Empty: none. In production the app also forces https URLs when
# APP_URL is https (FORCE_HTTPS=false disables it).
TRUSTED_PROXIES=
#FORCE_HTTPS=true
# Content-Security-Policy: empty = enabled only in production (never while the
# Vite dev server runs). HSTS is sent in production over https.
#SECURITY_CSP_ENABLED=
#SECURITY_HSTS_MAX_AGE=31536000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# One queue per responsibility (App\Support\Queues), each with its own
# workers (deploy/supervisor, deploy/systemd); rename only if several
# applications share the same queue backend. Workers use QUEUE_CONNECTION.
#QUEUE_NAME_WEBHOOKS=webhooks
#QUEUE_NAME_MESSAGES=messages
#QUEUE_NAME_REALTIME=realtime
#QUEUE_NAME_MEDIA=media
#QUEUE_NAME_NOTIFICATIONS=notifications
#QUEUE_NAME_EXPORTS=exports
#QUEUE_NAME_DEFAULT=default
# Redis option (production, optional): QUEUE_CONNECTION=redis, CACHE_STORE=redis
# (and REVERB_SCALING_ENABLED=true for several Reverb servers). Requires the
# phpredis extension (apt install php8.4-redis); predis is not installed.
#REDIS_QUEUE_RETRY_AFTER=900
#REDIS_QUEUE_AFTER_COMMIT=true

CACHE_STORE=database
# CACHE_PREFIX=
# Store of the rate limiters (empty: CACHE_STORE). The database store
# deadlocks under bursts on one limiter key (web chat, real-time channel
# authorization); in production keep the limits in Redis even when the rest
# of the cache stays in the database. Requires phpredis (see above).
#CACHE_LIMITER=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# S3-compatible services (Synology C2, MinIO): endpoint and, usually, path style
# "true". Time limits keep an endpoint that does not answer from blocking workers.
#AWS_ENDPOINT=
#AWS_SERVER_SIDE_ENCRYPTION=AES256
#AWS_HTTP_CONNECT_TIMEOUT=5
#AWS_HTTP_TIMEOUT=120
#AWS_REQUEST_CHECKSUM_CALCULATION=when_required
#AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

META_GRAPH_VERSION=
META_GRAPH_BASE_URL=
META_GRAPH_TIMEOUT=
META_MEDIA_UPLOAD_TIMEOUT=
# Meta app for Messenger / Instagram authorization and the app-level webhook (webhooks/meta).
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=
# META_INSTAGRAM_APP_ID=
# META_INSTAGRAM_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# META_INSTAGRAM_GRAPH_BASE_URL=
# META_HUMAN_AGENT_TAG=false
# Public Meta routes, per source address and minute (defaults shown). They
# count the real client address only with TRUSTED_PROXIES set behind Nginx.
# META_WEBHOOK_RATE_LIMIT=6000
# META_WEBHOOK_INVALID_SIGNATURE_LIMIT=30
# META_MEDIA_RATE_LIMIT=1200

# WhatsApp Web (QR) (docs/whatsapp-web-qr.md): unofficial modality, a phone linked by QR through the private Node
# service of services/whatsapp-web. It never replaces WhatsApp Cloud API: each connection chooses its modality.
# WHATSAPP_WEB_ENABLED shows the modality in Conexiones. WHATSAPP_WEB_SECRET is the shared secret of the internal
# HMAC signature (at least 32 random characters, the same value as WAWEB_SECRET of the service; without it nothing
# can be linked): php -r "echo bin2hex(random_bytes(32));"
WHATSAPP_WEB_ENABLED=false
WHATSAPP_WEB_URL=http://127.0.0.1:3410
WHATSAPP_WEB_SECRET=
# Seconds Laravel waits for the service.
#WHATSAPP_WEB_TIMEOUT=15
# How the service reaches this application to download the files it sends (same as WAWEB_LARAVEL_URL); APP_URL when empty.
#WHATSAPP_WEB_CALLBACK_URL=
# Optional hardening: addresses the service calls from (e.g. 127.0.0.1,::1). Empty: any address, the signature is always required.
#WHATSAPP_WEB_ALLOWED_IPS=
#WHATSAPP_WEB_EVENT_RATE_LIMIT=1800
# Chat history of a newly linked number (ADR-WWEB-1): stored as read-only history by the default queue. false discards
# what the service sends. Files are only fetched for messages at most this many days old.
#WHATSAPP_WEB_HISTORY=true
#WHATSAPP_WEB_HISTORY_MEDIA_DAYS=30

# WhatsApp Cloud API (docs/mensajeria-whatsapp.md). Credentials are stored encrypted per connection, never here.
# WHATSAPP_TRANSPORT: meta (production) | simulated (local development only) | unavailable (default: nothing is sent).
WHATSAPP_TRANSPORT=unavailable
# Optional controlled pilot: comma separated WhatsApp numbers (digits); when set, only they receive messages. Empty: no restriction.
WHATSAPP_PILOT_RECIPIENTS=
WHATSAPP_SIMULATE_STATUSES=true
WHATSAPP_SIMULATE_READ=false
WHATSAPP_WEBHOOK_MAX_BYTES=
WHATSAPP_WEBHOOK_RATE_LIMIT=
WHATSAPP_WEBHOOK_RETENTION_DAYS=
WHATSAPP_WEBHOOK_FAILED_RETENTION_DAYS=
# Connection errors and signals older than this (days) are replays and are not applied again. Empty = 7.
#WHATSAPP_WEBHOOK_MAX_AGE_DAYS=
# Periodic check of the active connections against Meta (every 30 minutes). Empty = 50 per run, evidence fresh for 90 minutes.
#WHATSAPP_MONITORING_MAX_PER_RUN=
#WHATSAPP_MONITORING_FRESH_MINUTES=
WHATSAPP_DELIVERY_MAX_ATTEMPTS=
WHATSAPP_RECONCILE_AFTER_MINUTES=
WHATSAPP_DOCUMENT_MAX_BYTES=
# Received stickers (WebP, static or animated). Empty = 5 MB.
WHATSAPP_STICKER_MAX_BYTES=
# Private disk of customer media: local (storage/app/private on this server), s3 (private bucket, AWS_* keys)
# or nas (a NAS share mounted on the server). Changing it only affects new files. See
# docs/infraestructura-y-despliegue.md "Almacenamiento de adjuntos".
MEDIA_DISK=local
# true: files are only accepted while the external disk (s3 or nas) is ready; never written to this server instead.
#MEDIA_DISK_REQUIRED=false
# MEDIA_DISK=nas: mount point and identity file of the mounted share (both required).
#MEDIA_MOUNT_PATH=
#MEDIA_MOUNT_ID=
#MEDIA_MOUNT_MARKER=.chat-manager-storage
#MEDIA_MOUNT_FSTYPES=cifs,smb3
#MEDIA_MOUNT_HEALTH_TTL=90
#MEDIA_MOUNT_PROBE_TIMEOUT=10
#MEDIA_MOUNT_VERIFY_HASH=true
# Warning on the system page when the recorded usage reaches the percent of the quota (0 = no quota; it never blocks).
#ATTACHMENT_STORAGE_QUOTA_BYTES=0
#ATTACHMENT_STORAGE_WARNING_PERCENT=80
#ATTACHMENT_PENDING_STALE_MINUTES=60
# Attachments (config/attachments.php): ZIP is sent as a signed expiring download link where the channel has no
# native type (WhatsApp, Messenger, Instagram). Empty = defaults (7 days, 100 MB, 30 downloads/min, web chat 25 MB).
WHATSAPP_MEDIA_LINK_FALLBACK=true
MESSENGER_MEDIA_LINK_FALLBACK=true
INSTAGRAM_MEDIA_LINK_FALLBACK=true
ATTACHMENT_LINK_TTL_DAYS=
ATTACHMENT_LINK_MAX_BYTES=
ATTACHMENT_LINK_DOWNLOADS_PER_MINUTE=
WEBCHAT_ATTACHMENT_MAX_BYTES=

VITE_APP_NAME="${APP_NAME}"

# Real-time (Laravel Reverb). Set BROADCAST_CONNECTION=reverb to enable it;
# with "log" or "null" the interface keeps working with periodic refresh.
# Generate your own id/key/secret (never reuse these placeholders). The
# browser reads host/port/scheme from the server (REVERB_CLIENT_* override
# them behind a reverse proxy, e.g. REVERB_CLIENT_HOST=chat.example.com,
# REVERB_CLIENT_PORT=443, REVERB_CLIENT_SCHEME=https). See docs/tiempo-real.md.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost
#REVERB_CLIENT_HOST=
#REVERB_CLIENT_PORT=
#REVERB_CLIENT_SCHEME=
#REVERB_APP_MAX_CONNECTIONS=
#REVERB_SCALING_ENABLED=false
#REVERB_SCALING_CHANNEL=reverb
# Queue (and optionally connection) of the real-time signals; defaults to the
# dedicated "realtime" queue (QUEUE_NAME_REALTIME). A connection other than
# QUEUE_CONNECTION needs a worker of its own (only the listeners use it).
#REALTIME_QUEUE=
#REALTIME_QUEUE_CONNECTION=

# Exports (Excel and PDF)
# PDF is printed by headless Chrome/Chromium through Browsershot (puppeteer
# from node_modules, without its bundled browser). Use absolute paths: queue
# workers and PHP-FPM usually run with a reduced PATH.
# Linux VPS example: apt install chromium nodejs npm
#   EXPORTS_NODE_BINARY=/usr/bin/node
#   EXPORTS_NPM_BINARY=/usr/bin/npm
#   EXPORTS_CHROME_PATH=/usr/bin/chromium
#   EXPORTS_CHROME_NO_SANDBOX=true   (only when Chrome runs as root/in a container)
# macOS example:
#   EXPORTS_CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
EXPORTS_NODE_BINARY=node
EXPORTS_NPM_BINARY=npm
EXPORTS_CHROME_PATH=
EXPORTS_CHROME_NO_SANDBOX=false
# Directory holding puppeteer (defaults to the project node_modules).
#EXPORTS_NODE_MODULES_PATH=
EXPORTS_PDF_TIMEOUT=120
# Files live on a private disk and expire after the retention window.
EXPORTS_DISK=local
EXPORTS_DIRECTORY=exports
EXPORTS_RETENTION_HOURS=24
# Large exports, the contacts importer and import rollbacks run on the
# "exports" queue (QUEUE_NAME_EXPORTS). EXPORTS_QUEUE overrides it for the
# whole group (exports, imports and rollbacks always share one queue).
# - Local development: `composer run dev` listens on every queue.
# - Production: a dedicated worker supervised by systemd/Supervisor, e.g.
#     php artisan queue:work --queue=exports --tries=1 --timeout=660 --memory=1024
# EXPORTS_JOB_TIMEOUT < worker --timeout < DB_QUEUE_RETRY_AFTER.
# EXPORTS_QUEUE=exports
EXPORTS_JOB_TIMEOUT=600
DB_QUEUE_RETRY_AFTER=900
EXPORTS_MEMORY_LIMIT=1024M
EXPORTS_XLSX_SYNC_ROWS=2000
EXPORTS_XLSX_MAX_ROWS=50000
# Cells per workbook (built in memory, ~0.8 KB each): rows are also capped at
# this value / columns of the report. Keep it below EXPORTS_MEMORY_LIMIT.
EXPORTS_XLSX_MAX_CELLS=800000
EXPORTS_PDF_SYNC_ROWS=500
EXPORTS_PDF_MAX_ROWS=5000

# Logical rollback of contact import batches (docs/migracion-whaticket.md).
#IMPORTS_ROLLBACK_ENABLED=true
#IMPORTS_ROLLBACK_DAYS=30
# Contact importer limits (config/imports.php defaults).
#IMPORTS_DISK=local
#IMPORTS_DIRECTORY=imports
#IMPORTS_MAX_KILOBYTES=5120
#IMPORTS_MAX_ROWS=5000
#IMPORTS_MAX_COLUMNS=30
#IMPORTS_MAX_UNCOMPRESSED_BYTES=52428800
#IMPORTS_MAX_ZIP_ENTRIES=200
#IMPORTS_MAX_COMPRESSION_RATIO=200
#IMPORTS_BATCH_SIZE=200

# Whaticket history importer (config/history-import.php, docs/migracion-whaticket.md). It runs on the "exports"
# queue. MAX_KILOBYTES defaults to 102400 (100 MB); larger files go through "php artisan history-import:add-file" (HISTORY_IMPORT_MAX_CLI_KILOBYTES). The upload is also limited by the web server and PHP
# (deploy/nginx client_max_body_size 110m, deploy/php-fpm upload_max_filesize 100M / post_max_size 110M): either
# set 102400 here so the application explains the limit itself, or raise those three values for larger files.
#HISTORY_IMPORT_MAX_KILOBYTES=102400
#HISTORY_IMPORT_MAX_ROWS=460000
#HISTORY_IMPORT_MAX_COLUMNS=80
#HISTORY_IMPORT_MAX_BODY_CHARACTERS=10000
#HISTORY_IMPORT_MAX_RECORD_BYTES=1048576
#HISTORY_IMPORT_MAX_MEDIA_BYTES=104857600
#HISTORY_IMPORT_PARSE_BATCH_SIZE=1000
#HISTORY_IMPORT_EXECUTE_CHUNK_SIZE=50
#HISTORY_IMPORT_JOB_SECONDS=240
#HISTORY_IMPORT_JOB_TIMEOUT=600
#HISTORY_IMPORT_MAX_ATTEMPTS=3
#HISTORY_IMPORT_RETENTION_DAYS=30
#HISTORY_IMPORT_DIRECTORY=history-imports

# Web chat (config/webchat.php). The demo host page only exists with APP_ENV=local.
#WEBCHAT_DEMO_ENABLED=
#WEBCHAT_SESSION_ABSOLUTE_DAYS=90
#WEBCHAT_SESSIONS_PER_IP_PER_MINUTE=10
#WEBCHAT_SESSIONS_PER_WIDGET_PER_MINUTE=300
#WEBCHAT_MESSAGES_PER_SESSION_PER_MINUTE=20
#WEBCHAT_MESSAGES_PER_IP_PER_MINUTE=60
#WEBCHAT_MESSAGES_PER_CONNECTION_PER_MINUTE=6000
# Integration API /api/v1, per token and minute.
#INTEGRATIONS_READS_PER_MINUTE=600
#INTEGRATIONS_WRITES_PER_MINUTE=60

# Chat interno (adjuntos en disco privado; ver docs/chat-interno.md)
TEAM_CHAT_DISK=local
TEAM_CHAT_MAX_KILOBYTES=51200
TEAM_CHAT_MAX_FILES=5
TEAM_CHAT_MESSAGE_MAX_LENGTH=4000
TEAM_CHAT_GROUP_MAX_PARTICIPANTS=100

# Web Push sin carga útil (ver docs/notificaciones-y-horarios.md). Genera las
# claves con `php artisan webpush:vapid`; vacías = push desactivado. Requiere
# HTTPS (o localhost). No tiene relación con la recepción de WhatsApp.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
#WEBPUSH_TTL=3600
#WEBPUSH_THROTTLE_SECONDS=60
#WEBPUSH_TIMEOUT=5
#WEBPUSH_RETENTION_DAYS=120
#WEBPUSH_ALLOWED_HOSTS=fcm.googleapis.com,android.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com

# Operations (Administración > Sistema, /health/ready, ops:check-alerts).
# Alerts (failed jobs spike, stopped scheduler, webhook/queue backlog) go to
# storage/logs/ops-*.log and by mail to OPS_ALERT_EMAILS (comma separated)
# and, with OPS_ALERT_NOTIFY_ADMINS=true, to the users holding system.view.
OPS_ALERT_EMAILS=
OPS_ALERT_NOTIFY_ADMINS=false
#OPS_ALERT_THROTTLE_MINUTES=60
#OPS_SCHEDULER_STALE_AFTER=300
#OPS_QUEUE_WARNING_PENDING=500
#OPS_QUEUE_CRITICAL_PENDING=5000
#OPS_QUEUE_WARNING_AGE=120
#OPS_QUEUE_CRITICAL_AGE=900
#OPS_FAILED_JOBS_WARNING=1
#OPS_FAILED_JOBS_CRITICAL=100
#OPS_FAILED_JOBS_SPIKE=10
#OPS_FAILED_JOBS_SPIKE_MINUTES=15
#OPS_WEBHOOK_WARNING_BACKLOG=50
#OPS_WEBHOOK_CRITICAL_BACKLOG=1000
#OPS_WEBHOOK_GRACE_SECONDS=120
#OPS_RECENT_ERRORS_TAIL_BYTES=262144
# Seconds the public /health/ready verdict is reused (0 = every request).
#OPS_READINESS_CACHE_SECONDS=10
# Address of the Reverb server for the health probe (defaults to REVERB_SERVER_HOST/PORT).
#OPS_REVERB_PROBE_HOST=127.0.0.1
#OPS_REVERB_PROBE_PORT=8080
#OPS_REVERB_PROBE_TIMEOUT=1.5
# Preflight: minimum free space on the storage/ disk, and directory of the
# database backups whose newest *.sql.gz must be younger than the limit
# (production: /var/backups/chat-manager/database, listable by the deploy user).
#OPS_PREFLIGHT_MIN_FREE_DISK_MB=2048
#OPS_BACKUP_DIR=
#OPS_BACKUP_MAX_AGE_HOURS=26
#LOG_OPS_DAYS=90

# Phase two (readiness, queue rules, service rules, SLA alerts and monitor,
# SLA compliance and productivity reports). Off = phase one. After changing it:
# php artisan config:cache && php artisan queue:restart && php artisan schedule:clear-cache
FEATURE_PHASE_TWO=false
