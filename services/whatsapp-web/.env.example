# Servicio WhatsApp Web (QR) de Chat Manager.
# En producción este archivo vive fuera de las versiones desplegadas:
#   /var/www/chat-manager/shared/whatsapp-web.env   (root:chatmanager-wa, chmod 640)
# y el proceso lo lee con WAWEB_ENV_FILE (deploy/supervisor/chat-manager-whatsapp-web.conf).
# Las variables que ya estén en el entorno del proceso tienen prioridad.
# Contrato: docs/whatsapp-web-qr-contrato.md §9.

# Dónde escucha la API de control. Solo la interfaz de loopback: nunca 0.0.0.0.
WAWEB_HOST=127.0.0.1
WAWEB_PORT=3410

# Secreto compartido con Laravel (firma HMAC de cada petición, en ambos
# sentidos). Mínimo 32 caracteres; el MISMO valor que WHATSAPP_WEB_SECRET en
# el .env de Laravel. Generar con: openssl rand -hex 32
WAWEB_SECRET=

# Base de Laravel para los eventos y los archivos salientes. Con la plantilla
# deploy/nginx/chat-manager-internal.conf (recomendado): http://127.0.0.1:8091
# Sin ella: la URL pública, https://mensajes.ejemplo.com
WAWEB_LARAVEL_URL=http://127.0.0.1:8091

# Directorio privado de sesiones, cola de eventos e idempotencia. Fuera de
# las versiones desplegadas y de cualquier carpeta pública o compartida;
# dueño el usuario del servicio, permisos 0700. Un despliegue no lo toca.
WAWEB_DATA_DIR=/var/lib/chatmanager/whatsapp-web

# Clave de cifrado en reposo (AES-256-GCM): 32 bytes en base64.
# Generar con: openssl rand -base64 32
# Si se pierde o se cambia, las sesiones guardadas dejan de abrir y hay que
# vincular cada número de nuevo. Respáldala aparte de los datos.
WAWEB_SESSION_KEY=

# Registro del servicio: fatal, error, warn, info, debug. Nunca incluye
# credenciales, códigos QR, texto de mensajes ni números completos.
WAWEB_LOG_LEVEL=info

# Registro de la biblioteca (Baileys). "silent" en producción: sus niveles
# debug y trace escriben contenido de mensajes. Súbelo solo para diagnosticar
# un problema concreto y vuelve a "silent".
WAWEB_LIBRARY_LOG_LEVEL=silent

# Renovaciones del QR antes de abandonar una vinculación sin escanear. El
# primer código dura 60 s y cada renovación 20 s (5 = 2 min 40 s en total).
WAWEB_QR_MAX_REFRESH=5

# Tamaño máximo de un archivo, entrante o saliente, en bytes (100 MB).
WAWEB_MAX_MEDIA_BYTES=104857600

# Reintentos de reconexión (2 s, 4 s, 8 s... hasta 60 s, con ±25 % de
# variación) antes de dejar la sesión en «error». Con 12, unos 8 minutos.
WAWEB_RECONNECT_MAX_ATTEMPTS=12

# Milisegundos de espera a que WhatsApp confirme un envío antes de responder
# 504 (resultado ambiguo: Laravel no lo reenvía por su cuenta).
WAWEB_SEND_TIMEOUT_MS=30000

# Milisegundos de espera a que Laravel reciba un evento.
WAWEB_EVENT_TIMEOUT_MS=15000
