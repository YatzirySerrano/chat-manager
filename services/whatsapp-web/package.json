{
    "name": "chatmanager-whatsapp-web",
    "version": "1.0.0",
    "private": true,
    "description": "Servicio privado de ChatManager para la modalidad WhatsApp Web (QR).",
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "dev": "node --import tsx src/index.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "node --import tsx --test \"test/**/*.test.ts\"",
        "cli": "node dist/cli.js"
    },
    "dependencies": {
        "baileys": "7.0.0-rc14",
        "pino": "10.4.0"
    },
    "devDependencies": {
        "@types/node": "22.20.5",
        "tsx": "4.23.15",
        "typescript": "7.0.2"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
