# Copy to .env.testing and fill in the credentials of a MariaDB user that can
# only access the testing database. The suite refuses any database whose name
# does not end in "_testing".
APP_NAME=ChatManager
APP_ENV=testing
APP_KEY=
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatmanager_testing
DB_USERNAME=chatmanager_test
DB_PASSWORD=
