APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The single application database (in production, the only one). Give its user
# privileges on this database only, so a typo can never create another one.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatmanager
DB_USERNAME=chatmanager_app
DB_PASSWORD=
# Destructive commands (migrate:fresh, migrate:rollback, db:wipe...) are blocked
# except on the testing database (chatmanager_testing) or when this flag is
# enabled on a local machine. Never in production.
DB_ALLOW_DESTRUCTIVE_COMMANDS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

META_GRAPH_VERSION=
META_GRAPH_BASE_URL=
META_GRAPH_TIMEOUT=

VITE_APP_NAME="${APP_NAME}"

# Exports (Excel and PDF)
# PDF is printed by headless Chrome/Chromium through Browsershot (puppeteer
# from node_modules, without its bundled browser). Use absolute paths: queue
# workers and PHP-FPM usually run with a reduced PATH.
# Linux VPS example: apt install chromium nodejs npm
#   EXPORTS_NODE_BINARY=/usr/bin/node
#   EXPORTS_NPM_BINARY=/usr/bin/npm
#   EXPORTS_CHROME_PATH=/usr/bin/chromium
#   EXPORTS_CHROME_NO_SANDBOX=true   (only when Chrome runs as root/in a container)
# macOS example:
#   EXPORTS_CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
EXPORTS_NODE_BINARY=node
EXPORTS_NPM_BINARY=npm
EXPORTS_CHROME_PATH=
EXPORTS_CHROME_NO_SANDBOX=false
EXPORTS_PDF_TIMEOUT=120
# Files live on a private disk and expire after the retention window.
EXPORTS_DISK=local
EXPORTS_DIRECTORY=exports
EXPORTS_RETENTION_HOURS=24
# Large exports and the contacts importer run on EXPORTS_QUEUE.
# - Local development: keep "default"; `composer run dev` already runs
#   `php artisan queue:listen` on the default queue, nothing else to start.
# - Production: use a dedicated queue (EXPORTS_QUEUE=exports) and a worker
#   supervised by systemd/Supervisor, e.g.
#     php artisan queue:work database --queue=exports,default --tries=1 --timeout=660 --memory=1024
#   (--timeout above EXPORTS_JOB_TIMEOUT, and both below DB_QUEUE_RETRY_AFTER).
# EXPORTS_JOB_TIMEOUT < worker --timeout < DB_QUEUE_RETRY_AFTER.
EXPORTS_QUEUE=default
EXPORTS_JOB_TIMEOUT=600
DB_QUEUE_RETRY_AFTER=900
EXPORTS_MEMORY_LIMIT=1024M
EXPORTS_XLSX_SYNC_ROWS=2000
EXPORTS_XLSX_MAX_ROWS=50000
EXPORTS_PDF_SYNC_ROWS=500
EXPORTS_PDF_MAX_ROWS=5000
